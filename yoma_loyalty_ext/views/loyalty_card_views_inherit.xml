<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_loyalty_card_tree_inherit_history_lines" model="ir.ui.view">
        <field name="name">loyalty.card.tree.inherit.history.lines</field>
        <field name="model">loyalty.card</field>

        <field name="inherit_id" ref="loyalty.loyalty_card_view_tree"/>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="optional">true</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_loyalty_card_form_inherit_history_lines" model="ir.ui.view">
        <field name="name">loyalty.card.form.inherit.history.lines</field>
        <field name="model">loyalty.card</field>

        <field name="inherit_id" ref="loyalty.loyalty_card_view_form"/>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="width">350</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='create_date']" position="attributes">-->
<!--                <attribute name="width">120</attribute>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='issued']" position="attributes">
                <attribute name="string">Earned</attribute>
                <attribute name="width">60</attribute>
            </xpath>
            <xpath expr="//field[@name='used']" position="attributes">
                <attribute name="width">60</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='partner_id']" position="after">-->
<!--                <field name="validity_days"/>-->
<!--            </xpath>-->
<!--            <xpath expr="//field[@name='points_display']" position="after">-->
<!--                <field name="points"/>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='history_ids']/list/field[@name='issued']" position="before">
                <field name="history_type" width="140"/>
            </xpath>
            <xpath expr="//field[@name='history_ids']/list/field[@name='used']" position="after">
                <field name="balance" width="70"/>
                <field name="expiration_date" width="150"/>
            </xpath>

        </field>
    </record>

</odoo>