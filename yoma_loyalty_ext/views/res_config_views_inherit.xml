<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_loyalty_view" model="ir.ui.view">
        <field name="name">res.config.settings.loyalty</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Loyalty" string="Loyalty">

                    <h2>Loyalty Program</h2>

                    <div class="row mt16 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">

                            <div class="o_setting_left_pane"/>

                            <div class="o_setting_right_pane">

                                <label for="loyalty_validity_days"/>

                                <div class="text-muted">
                                    Number of days loyalty points remain valid.
                                </div>

                                <field name="loyalty_validity_days"/>
                            </div>

                        </div>

                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>