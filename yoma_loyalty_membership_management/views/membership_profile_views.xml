<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_membership_profile_list" model="ir.ui.view">
        <field name="name">membership.profile.list</field>
        <field name="model">membership.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="member_code"/>
                <field name="tier_id"/>
                <field name="total_orders" width="120"/>
                <field name="total_spent"/>
                <field name="points_balance" width="150"/>
                <field name="currency_id" invisible="1" optional="1"/>
            </list>
        </field>
    </record>

    <record id="view_membership_profile_form" model="ir.ui.view">
        <field name="name">membership.profile.form</field>
        <field name="model">membership.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" placeholder="Select Member"/>
                        </h1>
                    </div>

                    <group string="Membership Details" cols="2">
                        <group>
                            <field name="birthday"/>
                            <field name="tier_id" widget="many2one_badge"/>
                            <field name="membership_status"/>
                            <field name="member_since"/>
                        </group>
                        <group>
                            <field name="points_balance"/>
                            <field name="member_code"/>
    <!--                        <field name="qr_code"/>-->
                            <field name="qr_image" widget="image" invisible="qr_code == False"/>
                        </group>
                    </group>
                    <group cols="2">
                        <group string="Statistics">
                            <field name="total_spent" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_orders"/>
                        </group>

                        <group string="Recent Activity">
                            <field name="last_activity_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record id="action_membership_profile" model="ir.actions.act_window">
        <field name="name">Membership Profiles</field>
        <field name="res_model">membership.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first membership profile!
            </p>
        </field>
    </record>

    <record id="action_loyalty_contacts" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('loyalty_partner', '=', True)]</field>
    </record>

    <menuitem id="menu_yoma_loyalty_membership_management_root"
              name="Loyalty App"
              sequence="10"
              web_icon="yoma_loyalty_membership_management,static/description/app_icon.png"/>

    <!-- Sub-menu Item under Membership -->
    <menuitem id="menu_membership_root"
              name="Membership"
              parent="menu_yoma_loyalty_membership_management_root"
              sequence="1"/>

    <menuitem id="menu_members"
              name="Members"
              parent="menu_membership_root"
              action="action_loyalty_contacts"
              sequence="1"/>

    <menuitem id="menu_membership_profile"
              name="Membership Profiles"
              parent="menu_membership_root"
              action="action_membership_profile"
              sequence="2"/>

</odoo>