<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_membership_tier_list" model="ir.ui.view">
        <field name="name">membership.tier.list</field>
        <field name="model">membership.tier</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="priority"/>
                <field name="currency_id" invisible="1" optional="1"/>
                <field name="min_spending" width="130"/>
                <field name="min_points" width="120"/>
<!--                <field name="multiplier"/>-->
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_membership_tier_form" model="ir.ui.view">
        <field name="name">membership.tier.form</field>
        <field name="model">membership.tier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tier Name"/>
                        </h1>
                    </div>

                    <group col="3">
                        <group string="Configuration">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="code" placeholder="Tier Code"/>
                        </group>

                        <group string="Requirements">
                            <field name="currency_id" invisible="1"/>
                            <field name="min_spending" widget="monetary" placeholder="Minimum Spending"/>
                            <field name="min_points" placeholder="Minimum Points"/>
                        </group>

                        <group string="Benefits">
<!--                            <field name="multiplier" widget="percentage" placeholder="Points Multiplier"/>-->
                            <field name="priority"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_membership_tier" model="ir.actions.act_window">
        <field name="name">Membership Tiers</field>
        <field name="res_model">membership.tier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first membership profile!
            </p>
        </field>
    </record>

    <menuitem id="menu_membership_tiers"
              name="Membership Tiers"
              parent="menu_membership_root"
              action="action_membership_tier"
              sequence="3"/>

</odoo>